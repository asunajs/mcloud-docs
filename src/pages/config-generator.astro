---
const title = '配置生成器';
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - mcloud-sign</title>
    <link rel="stylesheet" href="/monaco-editor/vs/editor/editor.main.css" />
    <style is:global>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        padding: 1rem;
        color: #1f2937;
        background: #f3f4f6;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 2px 12px rgb(0 0 0 / 10%);
      }
      .back-link { color: #4f46e5; text-decoration: none; }
      .header { margin-bottom: 1.5rem; text-align: center; }
      .header h1 { margin-bottom: .4rem; font-size: 1.6rem; }
      .header p, .hint { color: #6b7280; }
      .section, .account-item {
        margin-bottom: 1rem;
        padding: 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fafafa;
      }
      .section-title, .account-title { margin-bottom: .8rem; font-weight: 650; }
      .account-header, .output-header, .btn-group {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .6rem;
      }
      .form-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .8rem;
        margin-bottom: .8rem;
      }
      .form-row:last-child { margin-bottom: 0; }
      .form-row.full { grid-template-columns: 1fr; }
      .form-group { display: flex; flex-direction: column; gap: .3rem; }
      .form-group label { color: #4b5563; font-size: .82rem; font-weight: 550; }
      input, select, textarea {
        width: 100%;
        padding: .55rem .65rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        background: #fff;
        font: inherit;
      }
      textarea { min-height: 70px; resize: vertical; }
      details { margin-top: .8rem; }
      summary { cursor: pointer; color: #4f46e5; font-weight: 550; }
      .btn-group { justify-content: flex-start; flex-wrap: wrap; margin: 1rem 0; }
      button {
        padding: .6rem .9rem;
        border: 0;
        border-radius: 6px;
        color: #fff;
        background: #4f46e5;
        cursor: pointer;
        font-weight: 600;
      }
      button.secondary { background: #047857; }
      button.warning { background: #a16207; }
      button.danger { background: #b91c1c; }
      button.small { padding: .35rem .6rem; font-size: .78rem; }
      .output-section { margin-top: 1.2rem; padding: 1rem; border-radius: 8px; background: #111827; }
      .output-header { margin-bottom: .8rem; color: #fff; }
      #jsonEditor { min-height: 420px; overflow: hidden; border-radius: 6px; }
      .status { color: #b91c1c; font-size: .78rem; }
      .footer { margin-top: 1.5rem; color: #9ca3af; text-align: center; font-size: .78rem; }
      @media (max-width: 700px) {
        body { padding: .5rem; }
        .container { padding: 1rem; }
        .form-row { grid-template-columns: 1fr; }
        .btn-group button { width: 100%; }
        #jsonEditor { min-height: 360px; }
      }
    </style>
  </head>
  <body>
    <main class="container">
      <a href="/" class="back-link">← 返回文档</a>
      <header class="header">
        <h1>mcloud-sign 配置生成器</h1>
        <p>生成当前 v2 格式的 <code>asign.json</code>，表单与 JSON 双向同步。</p>
      </header>

      <section id="commonForm"></section>
      <section id="accountsList"></section>
      <section id="messageForm"></section>

      <div class="btn-group">
        <button id="addAccountBtn">添加账号</button>
        <button id="importFileBtn" class="secondary">导入 JSON</button>
        <button id="exportBtn" class="warning">导出 asign.json</button>
        <button id="clearBtn" class="danger">清除本地数据</button>
      </div>

      <section class="output-section">
        <div class="output-header">
          <strong>asign.json <span id="accountCount"></span></strong>
          <button id="copyBtn" class="small">复制配置</button>
        </div>
        <div id="jsonEditor"></div>
      </section>

      <p class="footer">配置 schema 来自 mcloud-sign 当前生成产物；JSON 运行时按项目设计直接加载，不依赖 schema 校验。</p>
    </main>

    <script is:inline src="/monaco-editor/vs/loader.js"></script>
    <script is:inline>
      window.__schemaReady = fetch('/config.schema.json')
        .then(function(response) { return response.json(); })
        .catch(function() { return null; });

      require.config({ paths: { vs: '/monaco-editor/vs' } });
      require(['vs/editor/editor.main'], function() {
        window.__schemaReady.then(function(schema) {
          if (schema) {
            monaco.languages.json.jsonDefaults.setDiagnosticsOptions({
              validate: true,
              allowComments: false,
              schemas: [{ uri: 'https://mcloud-sign.local/config.schema.json', fileMatch: ['*'], schema: schema }]
            });
          }
        });
        window._jsonEditor = monaco.editor.create(document.getElementById('jsonEditor'), {
          value: '{\n  "version": 2,\n  "caiyun": []\n}',
          language: 'json',
          theme: 'vs-dark',
          minimap: { enabled: false },
          automaticLayout: true,
          scrollBeyondLastLine: false,
          tabSize: 2,
          formatOnPaste: true,
          formatOnType: true,
          fontSize: 13
        });
        window.dispatchEvent(new Event('mcloud-editor-ready'));
      });
    </script>
    <script is:inline src="/config-generator.js"></script>
  </body>
</html>
